#!/usr/bin/bpftrace

// Identify which process is experiencing mutex contention, identify the futex address, 
// and calculate the total and average time spent inside futex wait operations.

// 1. sys_enter_futex -->> Detect FUTEX_WAIT and record start timestamp and address.
// 2. Thread waits inside kernel -->> Futex syscall executes.
// 3. sys_exit_futex -->> Calculate elapsed time and aggregate by PID and futex address.
// 4. interval:s:5 -->> Every five seconds, calculate and print total time, average time and count.

// Capture FUTEX_WAIT
tracepoint:syscalls:sys_enter_futex
{
    $op = args->op & 0x7F;

    if ($op == 0) {
        @start[tid] = nsecs;
        @addr[tid]  = (uint64)args->uaddr;
    }
}

// Capture FUTEX_WAIT exit
tracepoint:syscalls:sys_exit_futex
/@start[tid]/
{
// Why use PID here instead of TID?
// Because you want to aggregate the waiting statistics at the process level, rather than maintaining separate statistics for every thread.

    $pid  = pid;
    $addr = (uint64)@addr[tid];

    $delta = (uint64)(nsecs - @start[tid]);

    $prev = (uint64)@wait_total[$pid, $addr];

    @wait_total[$pid, $addr] = $prev + $delta;

// Count the wait operations : This increments the number of completed FUTEX_WAIT syscalls.
    @wait_count[$pid, $addr] += 1;

// Clean up temporary maps
    delete(@start[tid]);
    delete(@addr[tid]);
}

interval:s:5
{
    printf("\n%-6s %-18s %-40s %-12s %-12s %-8s\n", "PID", "MUTEX ADDR", "SYMBOL (SCOPE)", "TOTAL(ms)", "AVG(us)", "COUNT");

    for ($kv : @wait_total) {

        $pid   = $kv.0.0;
        $addr  = $kv.0.1;

        $total = (uint64)$kv.1;
        $count = (uint64)@wait_count[$pid, $addr];

        if ($count > 0) {

            $total_ms = $total / 1000000;
            $avg_us   = ($total / 1000) / $count;

            printf("%-6d %-18p %-40s %-12llu %-12llu %-8llu\n", $pid, $addr, usym((uint64)$addr), $total_ms, $avg_us, $count);
        }
    }

    clear(@wait_total);
    clear(@wait_count);
}

END
{
    clear(@start);
    clear(@addr);
}
